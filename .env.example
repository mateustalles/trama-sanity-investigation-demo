# Leave unset for personal/local mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Safety gate: enable only after the PostgreSQL workspace migration is applied.
TRAMA_HOSTED_TENANCY_READY=false
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Server-only pooled Postgres connection used by the hosted domain repository.
SUPABASE_DATABASE_URL=
TRAMA_CREDENTIAL_SECRET=
TRAMA_ADMIN_EMAILS=you@example.com
TRAMA_PUBLIC_URL=http://localhost:3000
# Public deployments can allow only unexpired judges and one existing operator.
TRAMA_DEMO_REQUIRE_JUDGE=false
TRAMA_DEMO_OPERATOR_ID=
# Optional build-time setting for a small self-hosted VPS.
TRAMA_LOW_MEMORY_BUILD=false
# Local Ollama context window; Context tool schemas require more than 4096 tokens.
TRAMA_OLLAMA_CONTEXT_SIZE=4096
# Public identifiers only. Do not put Sanity write or Context tokens in this file.
NEXT_PUBLIC_SANITY_PROJECT_ID=swuqfubs
NEXT_PUBLIC_SANITY_DATASET=trama-evidence-pilot
# Server-only token for the reviewed Delta application adapter. Never use NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
# Optional source user for the one-time, dry-run-first SQLite import.
TRAMA_IMPORT_USER_EMAIL=
# Read-only investigation demo. Keep both credentials server-side.
SANITY_ORGANIZATION_TOKEN=
OPENAI_API_KEY=
# Native KB demo: authorized Context MCP endpoint; mode and KB are fixed server-side.
SANITY_CONTEXT_EVIDENCE_MCP_URL=
# Historical GROQ experiments only; not a fallback for the native KB demo.
SANITY_CONTEXT_PILOT_GROQ_MCP_URL=
