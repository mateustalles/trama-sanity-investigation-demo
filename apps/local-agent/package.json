{
  "name": "@trama/local-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/agent.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "eval": "tsx src/run-evals.ts",
    "eval:rails": "tsx src/run-evals.ts --rails",
    "eval:guided": "tsx src/run-guided-agenda-evals.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@trama/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "latest"
  }
}
